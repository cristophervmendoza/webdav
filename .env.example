# Configuración del Servidor WebDAV para Microsoft Word
PORT=8003
HTTPS_PORT=8443

# Directorio de almacenamiento de documentos y plantillas
STORAGE_DIR=../backend_safrav/uploads/plantillas

# Base de datos PostgreSQL (Para sincronización atómica de versiones)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=galileo_data
DB_PORT=5432
HOST=127.0.0.1
NODE_OPTIONS=--dns-result-order=ipv4first
FRONTEND_URL=https://appsr003.vitorstream.shop
WEBDAV_PUBLIC_URL=https://appsr003.vitorstream.shop
SSL_DOMAIN=appsr003.vitorstream.shop
SSL_CERT_PATH=/etc/ssl/certs/appsr001-vitorstream-origin.crt
SSL_KEY_PATH=/etc/ssl/private/appsr001-vitorstream-origin.key
# Nginx termina TLS; Word recibe el certificado publico de Cloudflare.
TLS_MODE=proxy
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
